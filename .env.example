# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://fdr_user:fdr_pass@postgres:5432/fdr_portal
DATABASE_URL_SYNC=postgresql+psycopg2://fdr_user:fdr_pass@postgres:5432/fdr_portal

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO ─────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── App ───────────────────────────────────────────────
APP_NAME=FDR Portal
DEBUG=true

# ── JWT / Auth ────────────────────────────────────────
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION-JWT-SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OTP ───────────────────────────────────────────────
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5
REQUIRE_OTP=true
DEV_EXPOSE_OTP=true

# ── Rate Limiting ─────────────────────────────────────
RATE_LIMIT_AUTH=5/minute

# ── Document Encryption ──────────────────────────────
DOCUMENT_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# ── MinIO / Documents ─────────────────────────────────
MINIO_BUCKET=fdr-documents
MAX_UPLOAD_SIZE_MB=10

# ── Bank Verification ─────────────────────────────────
BANK_VERIFIER=mock

# ── Phase 4 — Clock & Demo ─────────────────────────────
CLOCK_OVERRIDE_DATE=
DEMO_MODE=false

# ── Phase 4 — Celery ───────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
DAILY_SCAN_HOUR=2
DAILY_SCAN_MINUTE=0

# ── Phase 4 — Email (MailHog) ──────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=fdr-portal@aicte.gov.in
SMTP_TLS=false

# ── Phase 4 — SMS ──────────────────────────────────────
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Phase 4 — Portal URL ───────────────────────────────
PORTAL_URL=http://localhost:8000
